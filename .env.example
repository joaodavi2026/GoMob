# Neon PostgreSQL (use a connection string "pooled" em DATABASE_URL e a direta em DIRECT_URL)
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/gomob?sslmode=require"
DIRECT_URL="postgresql://user:pass@ep-xxx.region.aws.neon.tech/gomob?sslmode=require"
# Segredo da sessão (>= 32 caracteres aleatórios)
SESSION_SECRET="troque-por-um-segredo-longo-e-aleatorio-com-32+chars"
# Token da API SPTrans Olho Vivo (somente servidor). Vazio = DEMO MODE
SPTRANS_API_TOKEN=""
# Opcional / desativado por padrão (exige faturamento Google)
GOOGLE_ROUTES_API_KEY=""
# Estilo MapLibre (padrão: demo tiles gratuitos do MapLibre)
NEXT_PUBLIC_MAP_STYLE_URL="https://demotiles.maplibre.org/style.json"
